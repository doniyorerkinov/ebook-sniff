  "homepage": "https://github.com/doniyorerkinov/ebook-sniff#readme",
  "repository": { "type": "git", "url": "git+https://github.com/doniyorerkinov/ebook-sniff.git" },
  "bugs": "https://github.com/doniyorerkinov/ebook-sniff/issues",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "types": "./dist/index.d.ts",
  "bin": { "ebook-sniff": "bin/ebook-sniff.js" },
  "files": ["dist", "bin"],
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
